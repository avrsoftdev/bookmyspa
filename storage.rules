rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload photos and documents to spa-related paths
    match /spa_photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024  // Max 5MB per image
        && request.resource.contentType.matches('image/.*');  // Only images
    }

    match /spa_documents/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024  // Max 10MB per document
        && request.resource.contentType.matches('image/.*');  // Only images (Aadhar/PAN/License)
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
